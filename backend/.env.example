APP_NAME=DiagnoSure API
APP_ENV=development
DEBUG=true
API_PREFIX=/api
FRONTEND_ORIGIN=http://192.168.31.238:5173
PASSPORT_SHARE_BASE_URL=http://192.168.31.238:8000
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/diagnosure
JWT_SECRET_KEY=replace_with_a_secure_random_secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
UPLOAD_DIR=backend/uploads
MAX_UPLOAD_SIZE_MB=10
MAPS_PROVIDER=osm_overpass
MAPS_API_KEY=
MAPS_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URLS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OVERPASS_CACHE_TTL_SECONDS=300
OVERPASS_MIN_INTERVAL_SECONDS=1
JITSI_PROVIDER=jitsi
JITSI_BASE_URL=https://meet.jit.si
NOTIFICATION_PROVIDER=local
FCM_PROJECT_ID=
FCM_CREDENTIALS_FILE=
REMINDER_POLL_INTERVAL_SECONDS=60
ENABLE_REMINDER_SCHEDULER=true
ENABLE_DEMO_FIXTURES=false
